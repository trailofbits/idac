prefix_rule(
    pattern = ["idac", "database", "open"],
    decision = "allow",
    justification = "Launch the persistent IDA host outside the per-command sandbox",
)

prefix_rule(
    pattern = ["uv", "run", "idac", "database", "open"],
    decision = "allow",
    justification = "Launch the persistent IDA host outside the per-command sandbox",
)
